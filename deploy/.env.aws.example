# Reference for the .env that ansible renders on the EC2 host from SSM.
# Secrets come from SSM (/pulse-rmm/<env>/...), the rest from ansible group_vars.
# Do not copy this file to the server by hand.

PULSE_DOMAIN=pulse.example.com
AWS_REGION=eu-central-1
S3_BUCKET=pulse-rmm-agent-binaries-123456789012
TURN_EXTERNAL_IP=203.0.113.10
IMAGE_REGISTRY=ghcr.io/mkozakk/pulse-rmm
IMAGE_TAG=latest

POSTGRES_USER=pulse
POSTGRES_PASSWORD=from_ssm
POSTGRES_DB=pulse

RABBITMQ_USER=pulse
RABBITMQ_PASSWORD=from_ssm
RABBITMQ_ERLANG_COOKIE=from_ssm

# minio is disabled on aws, these only satisfy compose.yaml substitution
MINIO_USER=unused
MINIO_PASSWORD=unused_on_aws
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

INTERNAL_API_SECRET=from_ssm
SCRIPT_SECRET_KEK=from_ssm
WEBHOOK_SECRET_KEK=from_ssm
CA_ROOT_KEY_SECRET=from_ssm

TURN_SECRET=from_ssm
TURN_URLS=turn:pulse.example.com:3478

PULSE_API_URL=https://pulse.example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=from_ssm

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=from_ssm
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_ISSUER_URI=https://pulse.example.com/auth/realms/pulse-rmm
KEYCLOAK_HOSTNAME=https://pulse.example.com/auth

REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_CAPACITY=200
RATE_LIMIT_REFILL_TOKENS=200
RATE_LIMIT_REFILL_SECONDS=60

SPRING_PROFILES_ACTIVE=prod,loki

GRAFANA_ADMIN_PASSWORD=from_ssm
